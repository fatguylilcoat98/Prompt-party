# Prompt Party — production configuration.
# Copy to .env next to docker-compose.yml (or /opt/prompt-party/.env for
# systemd) and fill in the secrets. Everything uses the PROMPT_PARTY_
# prefix, keeping this deployment fully separate from any other app.

PROMPT_PARTY_ENVIRONMENT=production
PROMPT_PARTY_HOST=127.0.0.1
PROMPT_PARTY_PORT=8710
PROMPT_PARTY_LOG_LEVEL=INFO

# Persistence (bind-mounted / persistent directories)
PROMPT_PARTY_DATABASE_URL=sqlite:///./data/prompt_party.db
PROMPT_PARTY_MEDIA_DIR=./media
PROMPT_PARTY_EXPORTS_DIR=./exports

# REQUIRED — the control-room key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROMPT_PARTY_PRODUCER_TOKEN=change-me

# Providers. "mock" runs full shows with zero external API calls —
# perfect for rehearsals. For real output, point at any OpenAI-compatible
# endpoint (Ollama: http://localhost:11434/v1, LM Studio: :1234/v1, or
# api.openai.com/v1).
PROMPT_PARTY_TEXT_PROVIDER=mock
PROMPT_PARTY_TEXT_PROVIDER_BASE_URL=
PROMPT_PARTY_TEXT_PROVIDER_API_KEY=
PROMPT_PARTY_TEXT_PROVIDER_MODEL=

PROMPT_PARTY_IMAGE_PROVIDER=mock
PROMPT_PARTY_IMAGE_PROVIDER_BASE_URL=
PROMPT_PARTY_IMAGE_PROVIDER_API_KEY=
PROMPT_PARTY_IMAGE_PROVIDER_MODEL=
