# Prompt Party configuration.
# Copy to .env and adjust. All variables use the PROMPT_PARTY_ prefix so this
# deployment can never collide with Team Talk configuration.

# --- Application ---
PROMPT_PARTY_ENVIRONMENT=development
PROMPT_PARTY_HOST=127.0.0.1
# Dedicated port, intentionally distinct from any Team Talk service.
PROMPT_PARTY_PORT=8710
PROMPT_PARTY_LOG_LEVEL=INFO

# --- Persistence (separate database and data directory from Team Talk) ---
PROMPT_PARTY_DATABASE_URL=sqlite:///./data/prompt_party.db
PROMPT_PARTY_MEDIA_DIR=./media
PROMPT_PARTY_EXPORTS_DIR=./exports

# --- Producer authority ---
# Token required for producer-only endpoints. Generate a strong random value.
PROMPT_PARTY_PRODUCER_TOKEN=change-me

# --- Provider adapters (Milestone 4; leave blank to use mock providers) ---
# Text generation (OpenAI-compatible endpoint)
PROMPT_PARTY_TEXT_PROVIDER=mock
PROMPT_PARTY_TEXT_PROVIDER_BASE_URL=
PROMPT_PARTY_TEXT_PROVIDER_API_KEY=
PROMPT_PARTY_TEXT_PROVIDER_MODEL=

# Image generation
PROMPT_PARTY_IMAGE_PROVIDER=mock
PROMPT_PARTY_IMAGE_PROVIDER_BASE_URL=
PROMPT_PARTY_IMAGE_PROVIDER_API_KEY=
PROMPT_PARTY_IMAGE_PROVIDER_MODEL=
